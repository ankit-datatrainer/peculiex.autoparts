# ---- Supabase (required) -----------------------------------------------------
# Project Settings -> API. The anon key is safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used by `npm run import:catalog` and `npm run make:admin`.
# NEVER expose this to the browser and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Optional ----------------------------------------------------------------
# Point at the old Express API only if you still run it; leave blank otherwise.
LEGACY_API_URL=

# ---- Invoice email (optional) ------------------------------------------------
# Pick ONE. Without either, orders still work and invoices are downloadable —
# only the automatic email is skipped (it logs why).
# RESEND_API_KEY=re_xxxxxxxx           # https://resend.com — no extra dependency
# SMTP_URL=smtps://user:pass@smtp.host:465   # any SMTP; also run: npm i nodemailer
# MAIL_FROM=MotoMart <orders@yourdomain.com>
# NEXT_PUBLIC_SITE_URL=https://autoparts.peculiex.com
