# ---- Supabase (required) -----------------------------------------------------
# Project Settings -> API. The anon key is safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Issues email verification codes, and is used by
# `npm run import:catalog` and `npm run make:admin`.
# NEVER expose this to the browser and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Optional ----------------------------------------------------------------
# Point at the old Express API only if you still run it; leave blank otherwise.
LEGACY_API_URL=

# ---- Email: verification codes + invoices (required) ------------------------
# Customers see prices only after verifying their email with a 6-digit code, so
# the server must be able to send mail. For Gmail, turn on 2-step verification
# and create an App Password (Google Account -> Security -> App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-letter-app-password
# MAIL_FROM=MotoMart <you@gmail.com>   # optional; defaults to SMTP_USER
# Alternatives to SMTP_HOST/USER/PASS:
# SMTP_URL=smtps://user:pass@smtp.host:465
# RESEND_API_KEY=re_xxxxxxxx
# NEXT_PUBLIC_SITE_URL=https://autoparts.peculiex.com
