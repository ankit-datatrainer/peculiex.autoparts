# ---- Supabase (required) -----------------------------------------------------
# Project Settings -> API. The anon key is safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used by `npm run import:catalog` and `npm run make:admin`.
# NEVER expose this to the browser and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Optional ----------------------------------------------------------------
# Point at the old Express API only if you still run it; leave blank otherwise.
LEGACY_API_URL=
